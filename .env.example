# Copy to .env and set your actual password locally. Never commit .env.
SIMAX_SECRET_DATABASE='replace-with-your-password'

# Optional runtime directory (relative to the working directory):
# SIMAX_DATA_DIR=data

# Optional trusted CA certificates when database TLS is enabled:
# SIMAX_PG_SSL_ROOT_CERT=C:/certificates/postgres-ca.crt
# SIMAX_MYSQL_SSL_CA=C:/certificates/mysql-ca.crt
